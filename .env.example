# Copy to .env. Every value is optional; defaults are shown.
LOG_LEVEL=info
# off | suggest | runtime  (see docs/self-healing.md)
HEAL_MODE=suggest
HEAL_THRESHOLD=0.75
# AI is off by default. Turn on only after `ollama pull <model>`.
AI_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=180000
# Agents (pnpm aiqa agents ...). auto = Ollama when AI_ENABLED=true, otherwise rules only.
# AGENT_PROVIDER=auto
# A model for agents only; default OLLAMA_MODEL. qwen3:8b calls tools more reliably than qwen2.5-coder:7b.
# AGENT_MODEL=qwen3:8b
# A hosted model through any OpenAI-compatible API. Your key stays in .env, which git ignores; CI never uses it.
# AGENT_PROVIDER=openai-compatible
# AGENT_BASE_URL=https://api.example.com/v1
# AGENT_API_KEY=
# AGENT_MODEL=
# Tool calls one agent run may make before it must answer.
# AGENT_MAX_TOOL_CALLS=6
# Point a target at a local copy when the hosted site is down, e.g.
# TARGET_SAUCEDEMO_URL=http://localhost:3000
