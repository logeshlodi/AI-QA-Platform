{
  "name": "ai-qa-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted enterprise Playwright automation platform (working core)",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.22.0 || >=24.6.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/dashboard/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "browsers": "pnpm --filter @aiqa/playwright-framework exec playwright install chromium firefox webkit",
    "test:shuffle": "pnpm --filter @aiqa/playwright-framework test:shuffle",
    "test:lighthouse": "pnpm --filter @aiqa/playwright-framework test:lighthouse",
    "test:chrome": "pnpm --filter @aiqa/playwright-framework test:chrome",
    "test:edge": "pnpm --filter @aiqa/playwright-framework test:edge",
    "test:smoke": "pnpm --filter @aiqa/playwright-framework exec playwright test --grep @smoke",
    "test:ui": "pnpm --filter @aiqa/playwright-framework test:history",
    "test:api": "pnpm --filter @aiqa/api-framework test:history",
    "test": "pnpm test:unit && pnpm test:api && pnpm test:ui",
    "report:dashboard": "node scripts/open-dashboard.mjs",
    "report:html": "pnpm --filter @aiqa/playwright-framework exec playwright show-report",
    "licenses": "pnpm licenses list",
    "security": "pnpm security:licences && pnpm security:audit && pnpm security:osv",
    "security:licences": "node scripts/check-licences.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "security:osv": "node scripts/osv.mjs",
    "security:zap": "node scripts/zap.mjs",
    "prepare": "husky",
    "report:allure": "pnpm --filter @aiqa/playwright-framework report:allure",
    "test:ai": "vitest run --config vitest.live.config.ts",
    "aiqa": "tsx packages/cli/src/bin.ts",
    "test:data": "pnpm --filter @aiqa/data-framework test:history",
    "test:contract": "pnpm --filter @aiqa/contract-tests test",
    "test:contract:consumer": "pnpm --filter @aiqa/contract-tests test:consumer",
    "stack:up": "docker compose -f infrastructure/docker/stack.compose.yml up -d --build --wait",
    "stack:down": "docker compose -f infrastructure/docker/stack.compose.yml down -v",
    "stack:test": "docker compose -f infrastructure/docker/stack.compose.yml --profile test up --build --abort-on-container-exit --exit-code-from data-tests",
    "test:perf": "pnpm --filter @aiqa/playwright-framework test:perf",
    "perf:load": "pnpm --filter @aiqa/load-tests start",
    "k8s:up": "node scripts/k8s.mjs up",
    "k8s:test": "node scripts/k8s.mjs test",
    "k8s:status": "node scripts/k8s.mjs status",
    "k8s:down": "node scripts/k8s.mjs down",
    "lab": "pnpm --filter @aiqa/examples lab",
    "test:labs": "pnpm --filter @aiqa/examples test:solutions",
    "mcp": "tsx packages/mcp-server/src/bin.ts",
    "test:agents": "vitest run packages/ai-agents packages/mcp-server",
    "agents:eval": "tsx packages/cli/src/bin.ts agents eval triage",
    "mcp:smoke": "node packages/mcp-server/scripts/smoke.mjs",
    "agents:eval:all": "tsx packages/cli/src/bin.ts agents eval all --record",
    "web": "pnpm --filter @aiqa/web dev",
    "test:web": "pnpm --filter @aiqa/web test",
    "test:components": "pnpm --filter @aiqa/dashboard test",
    "gallery": "pnpm --filter @aiqa/dashboard gallery"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "pnpm": "10.34.9",
    "prettier": "catalog:",
    "tslib": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
