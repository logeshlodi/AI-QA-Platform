{
  "realm": "aiqa",
  "enabled": true,
  "displayName": "AI-QA-Platform (local test realm)",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "catalog-admin",
        "description": "May create products and change their name, price and stock"
      },
      {
        "name": "dashboard-viewer",
        "description": "May sign in to the web app and read run history, heal audit and agent runs"
      }
    ]
  },
  "clients": [
    {
      "clientId": "catalog-admin-cli",
      "name": "catalog-admin-cli",
      "description": "Catalogue upkeep: has catalog-admin. Used by the data suites, the Pact provider check and k6.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-catalog-admin-cli-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-order-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "order-service",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {}
    },
    {
      "clientId": "storefront",
      "name": "storefront",
      "description": "A valid client of the order service without catalog-admin: its product writes get 403.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-storefront-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-order-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "order-service",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {}
    },
    {
      "clientId": "catalog-admin-short-lived",
      "name": "catalog-admin-short-lived",
      "description": "Has catalog-admin, but its tokens expire after 2 seconds: the expired-token test.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-catalog-admin-short-lived-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-order-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "order-service",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "access.token.lifespan": "2"
      }
    },
    {
      "clientId": "other-api-client",
      "name": "other-api-client",
      "description": "Has catalog-admin, but its tokens are for another API (audience other-api): the wrong-audience test.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-other-api-client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-other-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "other-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {}
    },
    {
      "clientId": "zap-scanner",
      "name": "zap-scanner",
      "description": "Has catalog-admin, tokens valid for an hour: the authenticated ZAP scan.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-zap-scanner-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-order-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "order-service",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "access.token.lifespan": "3600"
      }
    },
    {
      "clientId": "web",
      "name": "web",
      "description": "The platform's web app (apps/web): browser sign-in with the authorization code flow and PKCE.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-web-secret",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3200/auth/callback"],
      "webOrigins": ["http://localhost:3200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3200/signed-out"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-in-id-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-catalog-admin-cli",
      "enabled": true,
      "serviceAccountClientId": "catalog-admin-cli",
      "realmRoles": ["catalog-admin"]
    },
    {
      "username": "service-account-catalog-admin-short-lived",
      "enabled": true,
      "serviceAccountClientId": "catalog-admin-short-lived",
      "realmRoles": ["catalog-admin"]
    },
    {
      "username": "service-account-other-api-client",
      "enabled": true,
      "serviceAccountClientId": "other-api-client",
      "realmRoles": ["catalog-admin"]
    },
    {
      "username": "service-account-zap-scanner",
      "enabled": true,
      "serviceAccountClientId": "zap-scanner",
      "realmRoles": ["catalog-admin"]
    },
    {
      "username": "service-account-storefront",
      "enabled": true,
      "serviceAccountClientId": "storefront",
      "realmRoles": []
    },
    {
      "username": "qa-viewer",
      "enabled": true,
      "firstName": "Dashboard",
      "lastName": "Viewer",
      "email": "qa-viewer@aiqa.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-qa-viewer-password",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": ["dashboard-viewer"]
    },
    {
      "username": "qa-no-access",
      "enabled": true,
      "firstName": "No",
      "lastName": "Access",
      "email": "qa-no-access@aiqa.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-qa-no-access-password",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": []
    }
  ]
}
