{
  "name": "@aiqa/playwright-framework",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "playwright test",
    "test:history": "cross-env AIQA_HISTORY=ui playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:chrome": "cross-env PW_BRANDED_BROWSERS=chrome playwright test --project=chrome",
    "test:edge": "cross-env PW_BRANDED_BROWSERS=msedge playwright test --project=msedge",
    "test:shuffle": "playwright test --project=chromium --shuffle",
    "test:lighthouse": "playwright test --project=lighthouse",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui-mode": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "snapshots:update": "playwright test tests/visual --project=chromium --update-snapshots",
    "report:allure": "allure generate ./allure-results --output ./allure-report",
    "report:allure:open": "allure open ./allure-report",
    "test:perf": "cross-env PW_PERF=1 AIQA_HISTORY=perf playwright test --project=perf --workers=1"
  },
  "dependencies": {
    "@aiqa/ai-engine": "workspace:*",
    "@aiqa/reporting-engine": "workspace:*",
    "@aiqa/self-healing-engine": "workspace:*",
    "@aiqa/shared": "workspace:*",
    "@aiqa/test-data-engine": "workspace:*",
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "allure-playwright": "catalog:",
    "lighthouse": "catalog:",
    "web-vitals": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "allure": "catalog:",
    "cross-env": "catalog:"
  }
}
