{
  "name": "@aiqa/playwright-framework",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui-mode": "playwright test --ui",
    "snapshots:update": "playwright test tests/visual --project=chromium --update-snapshots",
    "report:allure": "allure generate ./allure-results --output ./allure-report",
    "report:allure:open": "allure open ./allure-report"
  },
  "dependencies": {
    "@aiqa/ai-engine": "workspace:*",
    "@aiqa/self-healing-engine": "workspace:*",
    "@aiqa/shared": "workspace:*",
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "allure-playwright": "catalog:"
  },
  "devDependencies": {
    "allure": "catalog:"
  }
}
